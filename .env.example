"""Updated .env.example with secure defaults and all required variables."""

# ==================== APPLICATION ====================
APP_NAME=Faceless Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ==================== DATABASE ====================
# Use PostgreSQL in production
DATABASE_URL=postgresql://postgres:password@localhost:5432/faceless_platform
DATABASE_ECHO=false

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRE=3600

# ==================== JWT & SECURITY ====================
# IMPORTANT: Change these in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-strong-random-string
SECRET_KEY=your-secret-key-change-this-in-production-use-strong-random-string
ENCRYPTION_KEY=your-32-character-encryption-key-here-must-be-32-chars
ALGORITHM=HS256

# ==================== CORS & HOSTS ====================
CORS_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=http://localhost:3000,http://localhost:8000,http://localhost,127.0.0.1

# ==================== OAUTH PROVIDERS ====================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ==================== AI SERVICES ====================
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# ElevenLabs for voice synthesis
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Replicate for model inference
REPLICATE_API_KEY=your-replicate-api-key

# ==================== AWS/CLOUD STORAGE ====================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=faceless-platform-uploads
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-id

# ==================== EMAIL SERVICE ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@facelessplatform.com

# ==================== PAYMENT PROCESSING ====================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ==================== ANALYTICS & MONITORING ====================
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=INFO

# ==================== VAULT SERVICES ====================
# HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token

# ==================== CONTENT PROCESSING ====================
MAX_FILE_SIZE=104857600
MAX_VIDEO_DURATION=600
TEMP_UPLOAD_DIR=./uploads/temp
PROCESSED_CONTENT_DIR=./uploads/processed

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX=100
API_RATE_LIMIT=1000

# ==================== FEATURE FLAGS ====================
ENABLE_ANALYTICS=true
ENABLE_MONETIZATION=true
ENABLE_AI_FEATURES=true
ENABLE_CONTENT_MODERATION=true

# ==================== FRONTEND ====================
REACT_APP_API_URL=http://localhost:8000
